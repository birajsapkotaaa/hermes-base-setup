[Unit]
Description=STEA Hermes AI Agent Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miam
WorkingDirectory=/opt/hermes
EnvironmentFile=/opt/hermes/.env
ExecStart=/usr/bin/python3 -m hermes run --config /opt/hermes/config.yaml
Restart=always
RestartSec=5s

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-agent

[Install]
WantedBy=multi-user.target
